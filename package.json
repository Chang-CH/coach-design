{
  "name": "@coach/design",
  "version": "0.1.0",
  "description": "Claude Coach shared design system: tokens, base theme, light/dark, card frame, code blocks.",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "styles.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.11"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.6.2"
  }
}
